<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_clmapi</name>
    <author>Berliner Schachverband</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Berliner Schachverband</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.1.2</version>
    <description>COM_CLMAPI_XML_DESCRIPTION</description>
    <namespace path="src">Bsv\Component\Clmapi</namespace>

    <install>
        <sql><file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file></sql>
    </install>
    <uninstall>
        <sql><file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file></sql>
    </uninstall>

    <files folder="site">
      <filename>apikey.php</filename>
    </files>

    <administration>
        <menu img="class:key">COM_CLMAPI</menu>
        <files folder="administrator">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
        <languages folder="language">
            <language tag="de-DE">de-DE/com_clmapi.ini</language>
            <language tag="de-DE">de-DE/com_clmapi.sys.ini</language>
        </languages>
    </administration>
</extension>
