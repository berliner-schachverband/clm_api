<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="COM_CLMAPI_FILTER_SEARCH" hint="JSEARCH_FILTER" />
        <field name="status" type="list" onchange="this.form.submit();">
            <option value="">COM_CLMAPI_FILTER_STATUS</option>
            <option value="active">COM_CLMAPI_STATUS_ACTIVE</option>
            <option value="revoked">COM_CLMAPI_STATUS_REVOKED</option>
            <option value="expired">COM_CLMAPI_STATUS_EXPIRED</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.created_at DESC"
               onchange="this.form.submit();">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.name ASC">COM_CLMAPI_SORT_NAME_ASC</option>
            <option value="a.name DESC">COM_CLMAPI_SORT_NAME_DESC</option>
            <option value="a.created_at DESC">COM_CLMAPI_SORT_CREATED_DESC</option>
            <option value="a.created_at ASC">COM_CLMAPI_SORT_CREATED_ASC</option>
            <option value="a.last_used_at DESC">COM_CLMAPI_SORT_LASTUSED_DESC</option>
        </field>
        <field name="limit" type="limitbox" class="input-mini" default="25" onchange="this.form.submit();" />
    </fields>
</form>
